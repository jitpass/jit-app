<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime only, no App Sandbox: the sandbox would block the
	     agent's Unix socket under ~/Library/Application Support. No Apple
	     Events either: the terminal is driven by opening a .command file, not
	     by scripting it. The Secure Enclave entitlement is not here: it
	     belongs to the helper that holds the key, Agent.entitlements. -->
</dict>
</plist>
