<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime only, no App Sandbox: the sandbox would block the
	     agent's Unix socket under ~/Library/Application Support. The Secure
	     Enclave keychain entitlement lands here in phase 3 of the design doc. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
